{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/app/api/**/*.ts",
    "src/app/api/**/**/*.ts",
    "src/app/api/**/**/**/*.ts", "src/app/api/account-data/sign-in/route.js", "src/app/api/account-data/emails/route.js", "src/app/api/account-data/sign-up/route.js",
    ],
  "exclude": [
    "node_modules"
  ]
}
